# Copy this file to scripts/cd_secrets.env and fill in your values.
# cd_secrets.env must never be committed — it is listed in .gitignore.

# ── iOS — TestFlight upload ───────────────────────────────────────────────────
APPLE_ID=you@example.com
# Generate at appleid.apple.com → Security → App-Specific Passwords
APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Android — signing ────────────────────────────────────────────────────────
ANDROID_KEYSTORE_PATH=/absolute/path/to/release.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# ── Android — Play Store API ─────────────────────────────────────────────────
# Create a service account in Google Play Console → Setup → API access,
# grant it "Release manager" permissions, download the JSON key.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json

# ── Web — Firebase Hosting ───────────────────────────────────────────────────
FIREBASE_PROJECT=my-project-id

# ── Notifications — Telegram ─────────────────────────────────────────────────
# Get a bot token from @BotFather, find your chat_id via getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Remote trigger ───────────────────────────────────────────────────────────
REMOTE_TRIGGER_WEBHOOK_URL=
